# Copy to .env and fill in secrets. Tuning defaults live in backend/app/config.py.

# --- Infrastructure (docker-compose overrides host/port for containers) ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
DATABASE_URL=postgresql+psycopg2://rag:rag@postgres:5432/rag
POSTGRES_PASSWORD=rag
IMAGES_DIR=data/images
UPLOADS_DIR=data/uploads

# --- Groq (required) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_AUX_MODEL=openai/gpt-oss-20b

# --- SQL agent (OpenRouter preferred when key is set; Groq fallback otherwise) ---
SQL_AGENT_OPENROUTER_API_KEY=your_openrouter_api_key_here
SQL_CREDENTIALS_KEY=

# --- Auth ---
JWT_SECRET=generate-a-long-random-secret-for-production
REQUIRE_SECURE_JWT_SECRET=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
