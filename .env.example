# Defaults for docker-compose (override in .env for local host testing)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# Groq Cloud API (required from Phase 5; scaffolded in Phase 1)
GROQ_API_KEY=your_groq_api_key_here

# Embedding model (fixed for index mapping dimension)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Paths (relative to project root)
IMAGES_DIR=data/images
UPLOADS_DIR=data/uploads

# Text chunking (Phase 2)
CHUNK_MAX_WORDS=400
CHUNK_OVERLAP_WORDS=50

# Retrieval (Phase 3)
DEFAULT_TOP_K=8

# PDF side-panel viewer: pages rendered before/after the cited page
PDF_VIEWER_PAGE_WINDOW=2

# DOCX viewer: forward search window (pages) when locating chunk text in rendered preview
DOCX_VIEWER_SEARCH_WINDOW_PAGES=3
# DOCX viewer: min fraction of chunk tokens that must match (in order) to accept a highlight
DOCX_VIEWER_MIN_MATCH_RATIO=0.6
# DOCX embedded images: minimum pixel area (width × height) to index; lower than PDF
# because Word embeds intentional small inline icons (e.g. 32×32 dots) that PDF
# page extraction would treat as noise. PDF raster threshold stays 8000 px² in code.
DOCX_MIN_IMAGE_PIXELS=256
# DOCX proximity: attach images within ±N block ordinals of a text/table anchor
DOCX_PROXIMITY_BLOCK_WINDOW=1

# Image attachment (PDF proximity + PDF/DOCX intent): surface relevant images beside answers
IMAGE_ATTACH_ENABLED=true
# Proximity (implicit relevance, e.g. "who is the chairman")
IMAGE_PROXIMITY_ANCHOR_COUNT=3
IMAGE_PROXIMITY_SCORE_RATIO=0.7
IMAGE_PROXIMITY_COLUMN_OVERLAP_MIN=0.25
IMAGE_PROXIMITY_MARGIN_PX=80
IMAGE_MIN_ATTACHMENT_SCORE=0.3
# Hero strip dedup + cap
IMAGE_MAX_DISPLAY=2
IMAGE_DEDUP_IOU=0.6
# Intent gate (explicit requests, e.g. "show me the chart") — parallel Groq call
IMAGE_INTENT_ENABLED=true
IMAGE_INTENT_MODEL=llama-3.1-8b-instant
# Rewrite ambiguous follow-up queries using recent chat history before retrieval.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=llama-3.1-8b-instant
IMAGE_INTENT_TOP_K=3
# Explicit image requests display only the single best match
IMAGE_INTENT_MAX_DISPLAY=1
# Intent image relevance gate (drop loosely-matching images like cover pages)
IMAGE_INTENT_SCORE_RATIO=0.6
IMAGE_INTENT_MIN_SCORE=0.0

# Conversation memory: recent turns fed to the answer LLM + follow-up query rewriting
CHAT_HISTORY_TURNS=6
# Optional path to LibreOffice soffice binary (soft dependency; omit to auto-detect)
# LIBREOFFICE_PATH=/usr/bin/soffice

# Auth + PostgreSQL (Phase 1)
DATABASE_URL=postgresql+psycopg2://rag:rag@postgres:5432/rag
JWT_SECRET=generate-a-long-random-secret-for-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=rag_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Production hardening (Phase 4)
REQUIRE_SECURE_JWT_SECRET=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
UPLOAD_RATE_LIMIT_PER_MINUTE=10
QUERY_RATE_LIMIT_PER_MINUTE=30
