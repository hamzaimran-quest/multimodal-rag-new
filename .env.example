# Defaults for docker-compose (override in .env for local host testing)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# Groq Cloud API (required from Phase 5; scaffolded in Phase 1)
GROQ_API_KEY=your_groq_api_key_here
# Answer generation (grounded responses) and agent router
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
# Auxiliary Groq calls (query rewrite, etc.)
GROQ_AUX_MODEL=openai/gpt-oss-20b

# Embedding model (fixed for index mapping dimension)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Paths (relative to project root)
IMAGES_DIR=data/images
UPLOADS_DIR=data/uploads

# Text chunking (Phase 2)
CHUNK_MAX_WORDS=400
CHUNK_OVERLAP_WORDS=50

# Retrieval (Phase 3)
DEFAULT_TOP_K=5

# PDF side-panel viewer: pages rendered before/after the cited page
PDF_VIEWER_PAGE_WINDOW=2

# DOCX viewer: forward search window (pages) when locating chunk text in rendered preview
DOCX_VIEWER_SEARCH_WINDOW_PAGES=3
# DOCX viewer: min fraction of chunk tokens that must match (in order) to accept a highlight
DOCX_VIEWER_MIN_MATCH_RATIO=0.6

# XLSX ingestion: adaptive row bands when a sheet has no Excel Table objects.
# Narrow sheets (few columns) use EXCEL_ROW_BAND_SIZE; medium/wide sheets use smaller bands.
EXCEL_ROW_BAND_SIZE=30
EXCEL_ROW_BAND_SIZE_MEDIUM=15
EXCEL_ROW_BAND_SIZE_WIDE=10
EXCEL_MEDIUM_COLUMN_THRESHOLD=6
EXCEL_WIDE_COLUMN_THRESHOLD=10
# Retrieval: max XLSX chunks (search top_k, post-expand cap, and mixed-scope XLSX limit).
EXCEL_TOP_K=5
# PDF retrieval: wider context + multiple table chunks for LLM disambiguation -- set for testing
# PDF_TOP_K=6
# PDF_TABLE_SLOTS=2
# PDF_TABLE_CANDIDATE_POOL=8
# Grounded answer: max chars of retrieved context sent to the LLM (0 = no limit).
LLM_CONTEXT_MAX_CHARS=12000

# Image attachment (PDF only): surface relevant images beside text answers
IMAGE_ATTACH_ENABLED=true
# Proximity (implicit relevance, e.g. "who is the chairman")
IMAGE_PROXIMITY_ANCHOR_COUNT=3
IMAGE_PROXIMITY_SCORE_RATIO=0.7
IMAGE_PROXIMITY_COLUMN_OVERLAP_MIN=0.25
IMAGE_PROXIMITY_MARGIN_PX=80
IMAGE_MIN_ATTACHMENT_SCORE=0.3
# Hero strip dedup + cap
IMAGE_MAX_DISPLAY=2
IMAGE_DEDUP_IOU=0.6
# Agent search_images tool: how many image chunks to retrieve
IMAGE_INTENT_TOP_K=3
# DOCX image proximity: attach images within ±N body blocks of a text/table anchor.
DOCX_IMAGE_PROXIMITY_BLOCK_RADIUS=2

# SQL Agent (optional user PostgreSQL connections)
SQL_AGENT_ENABLED=true
# SQL agent LLM — OpenRouter (preferred when key is set); Groq used as fallback otherwise
SQL_AGENT_OPENROUTER_API_KEY=your_openrouter_api_key_here
SQL_AGENT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SQL_AGENT_MODEL=openai/gpt-oss-120b
SQL_AGENT_MAX_STEPS=10
SQL_AGENT_QUERY_TIMEOUT_SECONDS=30
SQL_AGENT_MAX_ROWS=100
SQL_CREDENTIALS_KEY=
SQL_CONNECTION_CACHE_TTL_SECONDS=300
SQL_SCHEMA_MAX_TABLES=40
SQL_SCHEMA_MAX_CHARS=12000
SQL_SCOPE_CLASSIFIER_ENABLED=true
SQL_SCOPE_CLASSIFIER_MODEL=openai/gpt-oss-20b
SQL_SCOPE_CLASSIFIER_TIMEOUT_SECONDS=20
SQL_SCOPE_MIN_CONFIDENCE=0.55
# Optional path to LibreOffice soffice binary (soft dependency; omit to auto-detect)
# LIBREOFFICE_PATH=/usr/bin/soffice

# Follow-up query rewriting (prior user questions + latest assistant reply; aux model)
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=openai/gpt-oss-20b
CHAT_HISTORY_TURNS=6
CHAT_HISTORY_QUERY_MAX_CHARS=400
CHAT_LAST_REPLY_MAX_CHARS=800

# Chart tool (aux LLM → Chart.js config → QuickChart.io image URL)
CHART_LLM_MODEL=openai/gpt-oss-20b
CHART_TABLE_MAX_CHARS=4000
QUICKCHART_WIDTH=500
QUICKCHART_HEIGHT=300

# Agent router (Groq tool-calling)
AGENT_MODEL=openai/gpt-oss-120b
AGENT_MAX_ROUNDS=1
AGENT_TOOL_SNIPPET_MAX_CHARS=200

DATABASE_URL=postgresql+psycopg2://rag:rag@postgres:5432/rag
JWT_SECRET=generate-a-long-random-secret-for-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=rag_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Production hardening (Phase 4)
REQUIRE_SECURE_JWT_SECRET=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
UPLOAD_RATE_LIMIT_PER_MINUTE=10
QUERY_RATE_LIMIT_PER_MINUTE=30


EXCEL_SCHEMA_ENABLED=true
EXCEL_SCHEMA_MODEL=openai/gpt-oss-20b
EXCEL_SCHEMA_SAMPLE_ROWS=20
EXCEL_SCHEMA_MIN_OVERLAP_RATIO=0.9
EXCEL_SCHEMA_SOFT_LINK_OVERLAP_RATIO=0.85
EXCEL_SCHEMA_MAX_RETRIES=3
EXCEL_ANCHOR_MAX_ENTITIES=3
EXCEL_CLUSTER_EXPAND_PER_ANCHOR=12